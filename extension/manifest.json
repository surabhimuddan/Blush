{
  "manifest_version": 3,
  "name": "KoiPilot",
  "version": "0.1.0",
  "description": "Blush the pixel fish shows you where to click, checks it worked, and remembers it.",
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "action": {
    "default_title": "KoiPilot",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:8787/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-reader.js", "verifiers.js", "overlay.js", "content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/*", "assets/sprite-frames/*", "assets/icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
